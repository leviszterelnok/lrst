// namespace Shapes. Its code uses .Util.Math, so it includes that file.
include "/util/math.lrs"

namespace Shapes {
    pub struct Circle { pub r: f64 }
    pub struct Rect { pub w: f64, pub h: f64 }

    impl Circle {
        pub fn new(r: f64) -> Circle { Circle { r } }
        pub fn area(&self) -> f64 { .Util.Math.PI * .Util.Math.sqr(self.r) }
    }

    impl Rect {
        pub fn new(w: f64, h: f64) -> Rect { Rect { w, h } }
        pub fn area(&self) -> f64 { self.w * self.h }
    }

    // Same name as Util.Text.label: see the mount in main.lrs.
    pub fn label(name: &str) -> String { format!("[shape] {}", name) }
}
