// lrs demo. Run it with:  lrs run .
//
//   main.lrs        this file: includes, mounts, fn main()
//   shapes.lrs      namespace Shapes       (Circle, Rect, label)
//   util/math.lrs   namespace Util.Math    (PI, sqr, clamp)
//   util/text.lrs   namespace Util.Text    (shout, label)
//
// `Util` is filled by two files: declarations of the same namespace merge.

// --- 1. include: add files to the project --------------------------------
include "shapes.lrs"          // relative to this file
include "util/text.lrs"
include "/util/math.lrs"      // leading `/` = from the project root
                              // (shapes.lrs includes it too: still loaded once)

// --- 2. mount: use a namespace without its prefix ------------------------
// Names of .Shapes and .Util.Text now work in the root as if defined here.
// Both have a `label`: the first mount wins, so `label` means .Shapes.label.
namespace { .Shapes; .Util.Text }

// A mount can also go into another namespace instead of the root:
namespace Report {
    namespace { .Shapes }     // inside .Report, Circle and Rect need no prefix

    pub fn circle_line(r: f64) -> String {
        let c = Circle::new(r);
        format!("circle r={} has area {:.2}", c.r, c.area())
    }
}

fn main() {
    // Mounted names, no prefix:
    let circle = Circle::new(1.0);
    let rect = Rect::new(2.0, 3.0);
    println!("areas:     {:.2} and {}", circle.area(), rect.area());
    println!("shout:     {}", shout("hello"));
    println!("label:     {}", label("x"));

    // --- 3. paths: start with `.`, always absolute from the root ---------
    println!("other:     {}", .Util.Text.label("x"));   // the label that lost the clash
    println!("clamp:     {}", .Util.Math.clamp(15, 0, 10));
    println!("pi:        {:.4}", .Util.Math.PI);

    // A path works anywhere an expression does, e.g. in a closure:
    let radii = [1.0, 2.0, 3.0];
    let areas: Vec<f64> = radii.iter().map(|r| .Shapes.Circle::new(*r).area()).collect();
    println!("circles:   {:.1?}", areas);

    println!("report:    {}", .Report.circle_line(2.0));

    // --- 4. privacy: no `pub` = private to the file ----------------------
    // .Util.Math.internal_mul(2.0, 3.0);   // error: private to util/math.lrs
}
