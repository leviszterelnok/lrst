namespace Utils.Math {
    pub const PI: f64 = 3.14159265358979;

    pub fn sqr(x: i32) -> i32 { x * x }

    pub fn lerp(a: f64, b: f64, t: f64) -> f64 { a + (b - a) * t }

    fn private_helper() {} // not visible outside Utils.Math
}

namespace Utils {
    // mounting a sibling namespace: `clamp` becomes available as .Utils.clamp
    namespace { .Utils.Math }

    pub fn clamp(v: i32, lo: i32, hi: i32) -> i32 {
        if v < lo { lo } else if v > hi { hi } else { v }
    }

    // `Shape` here collides with Graphics.Core.Shape; the global mount order decides
    pub struct Shape;
}
